# Banana Roll — local environment. Copy to `.env` (gitignored) and tweak.
# Loaded via `npm run dev` (Node's --env-file). Production sets these in Railway.

# Port the relay listens on.
PORT=8765

# Absolute base for generated links (overlay/setup URLs). Match PORT above.
BASE_URL=http://localhost:8765

# --- State backend (pick ONE; leave both unset for pure in-memory) ----------
# Redis: durable per-room keys + cross-instance pub/sub. Local install below.
REDIS_URL=redis://127.0.0.1:6379

# JSON file backend instead of Redis (single instance, no broker). Mutually
# exclusive with REDIS_URL — REDIS_URL wins if both are set.
# STATE_FILE=.state.json
